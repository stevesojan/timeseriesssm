{
  "dataset": "ETTm2",
  "csv": "ETTm2.csv",
  "freq": "15min",
  "seq_len": 96,
  "horizons": [
    96,
    192,
    336,
    720
  ],
  "model": {
    "patch_len": 16,
    "hidden_dim": 96,
    "rank_dim": 64,
    "num_blocks": 2,
    "dropout": 0.0,
    "quantile_levels": [],
    "mse_weight": 0.0,
    "mae_weight": 1.0,
    "pinball_weight": 0.0,
    "time_mix": "off",
    "time_context_bidirectional": false,
    "cascade": "nhits",
    "use_glu_ffn": false,
    "nhits_blocks_per_stack": 1,
    "use_revin": true,
    "use_calendar": false,
    "linear_path": true,
    "channel_mix_scale": 1.0,
    "channel_mix_learn": true,
    "series_tokens": false,
    "freq_loss_weight": 0.5,
    "lowpass_frac": 0.5,
    "stat_head": true,
    "horizon_weight": "arctan",
    "rcf_cycle": 96
  },
  "train": {
    "lr": 0.0028485082384338985,
    "schedule": "type1",
    "epochs": 10,
    "patience": 3,
    "batch_size": 64,
    "weight_decay": 0.0,
    "grad_clip": 0.0,
    "ema_decay": 0.995
  }
}
