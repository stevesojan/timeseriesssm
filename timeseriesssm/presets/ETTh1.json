{
  "dataset": "ETTh1",
  "csv": "ETTh1.csv",
  "freq": "h",
  "seq_len": 96,
  "horizons": [
    96,
    192,
    336,
    720
  ],
  "model": {
    "patch_len": 16,
    "hidden_dim": 64,
    "rank_dim": 64,
    "num_blocks": 2,
    "dropout": 0.25,
    "quantile_levels": [],
    "mse_weight": 0.0,
    "mae_weight": 1.0,
    "pinball_weight": 0.0,
    "time_mix": "off",
    "time_context_bidirectional": false,
    "cascade": "nhits",
    "use_glu_ffn": false,
    "nhits_blocks_per_stack": 1,
    "use_revin": true,
    "use_calendar": true,
    "linear_path": true,
    "channel_mix_scale": 0.0,
    "channel_mix_learn": false,
    "series_tokens": true,
    "series_dim": 128,
    "series_layers": 1,
    "freq_loss_weight": 0.5,
    "lowpass_frac": 0.0,
    "stat_head": true,
    "horizon_weight": "arctan",
    "series_mixer": "star",
    "rcf_cycle": 24
  },
  "train": {
    "lr": 0.0022184920849567693,
    "schedule": "cosine",
    "epochs": 10,
    "patience": 10,
    "batch_size": 32,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "ema_decay": 0.995
  }
}
