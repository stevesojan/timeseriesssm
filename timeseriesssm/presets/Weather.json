{
  "dataset": "Weather",
  "csv": "weather.csv",
  "freq": "10min",
  "seq_len": 96,
  "horizons": [
    96,
    192,
    336,
    720
  ],
  "model": {
    "patch_len": 8,
    "hidden_dim": 128,
    "rank_dim": 48,
    "num_blocks": 2,
    "dropout": 0.0,
    "quantile_levels": [],
    "mse_weight": 0.0,
    "mae_weight": 1.0,
    "pinball_weight": 0.0,
    "time_mix": "causal_decay",
    "time_context_bidirectional": false,
    "cascade": "nhits",
    "use_glu_ffn": false,
    "nhits_blocks_per_stack": 1,
    "use_revin": true,
    "use_calendar": false,
    "linear_path": false,
    "channel_mix_scale": 1.0,
    "channel_mix_learn": false,
    "series_tokens": false,
    "freq_loss_weight": 0.5,
    "lowpass_frac": 0.0,
    "stat_head": true,
    "horizon_weight": "arctan",
    "rcf_cycle": 144
  },
  "train": {
    "lr": 0.0005162093000226361,
    "schedule": "type1",
    "epochs": 10,
    "patience": 3,
    "batch_size": 64,
    "weight_decay": 1e-05,
    "grad_clip": 0.0,
    "ema_decay": 0.995
  }
}
